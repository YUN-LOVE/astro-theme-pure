{
  "name": "astro-theme-pure",
  "type": "module",
  "version": "4.1.4",
  "scripts": {
    "dev": "astro dev",
    "dev:check": "astro check --watch & astro dev",
    "build": "astro-pure check && astro check && astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "astro check",
    "astro": "astro",
    "pure": "astro-pure",
    "format": "prettier --write  '**/*.{js,jsx,ts,tsx,md,mdx,astro}'",
    "lint": "eslint --fix 'src/**/*.{js,ts,jsx,tsx,astro}'",
    "yijiansilian": "bun lint && bun sync && bun check && bun format",
    "clean": "rm -rf .astro .vercel dist",
    "cache:avatars": "tsx preset/scripts/cacheAvatars.ts",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@astro-community/astro-embed-vimeo": "^0.3.12",
    "@astro-community/astro-embed-youtube": "^0.5.10",
    "@astrojs/check": "0.9.8",
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/compiler-rs": "^0.1.10",
    "@astrojs/rss": "4.0.18",
    "@astrojs/vercel": "10.0.4",
    "@waline/client": "^3.15.2",
    "astro": "^6.4.8",
    "astro-pure": "1.4.6",
    "katex": "^0.16.47",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.110.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1"
  },
  "overrides": {
    "vite": "^7"
  }
}